# Copy to /f/FYP/.env (repo root, git-ignored) and fill in. Either style works.

# New-style access token: kaggle.com > Settings > API > Generate New Token
KAGGLE_API_TOKEN=

# Legacy style (Settings > API > Create Legacy API Key -> kaggle.json values). Username is needed to build the kernel slug.
KAGGLE_USERNAME=
KAGGLE_KEY=
